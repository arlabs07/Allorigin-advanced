entrypoint = "index.js"
modules = ["web", "nodejs-20"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-25_05"

[deployment]
run = ["node", "index.js"]
deploymentTarget = "autoscale"
ignorePorts = false

[[ports]]
localPort = 80

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Start ProxyForge"

[[workflows.workflow]]
name = "Start ProxyForge"
author = 46986989
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js"

[agent]
expertMode = true
